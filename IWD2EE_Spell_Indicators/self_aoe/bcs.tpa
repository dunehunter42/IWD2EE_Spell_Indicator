ACTION_IF FILE_EXISTS_IN_GAME ~63MOUR2C.bcs~ BEGIN
 COPY_EXISTING ~63MOUR2C.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(ThirdNearestEnemyOf(Myself),WIZARD_MALAVONS_RAGE)~ ~Spell(Myself,WIZARD_MALAVONS_RAGE)~
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(ThirdNearestEnemyOf(Myself),WIZARD_WAIL_OF_THE_BANSHEE)~ ~Spell(Myself,WIZARD_WAIL_OF_THE_BANSHEE)~
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(NearestEnemyOf(Myself),WIZARD_SUNFIRE)~ ~Spell(Myself,WIZARD_SUNFIRE)~
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(SecondNearestEnemyOf(Myself),WIZARD_SUNFIRE)~ ~Spell(Myself,WIZARD_SUNFIRE)~
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(ThirdNearestEnemyOf(Myself),WIZARD_SUNFIRE)~ ~Spell(Myself,WIZARD_SUNFIRE)~
  END
 BUT_ONLY_IF_IT_CHANGES
END
