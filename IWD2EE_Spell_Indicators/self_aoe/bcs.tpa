ACTION_IF FILE_EXISTS_IN_GAME ~00SSCHRM.bcs~ BEGIN
 COPY_EXISTING ~00SSCHRM.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
   REPLACE_TEXTUALLY EXACT_MATCH ~Spell(LastSeenBy(Myself),CLERIC_HEALING_CIRCLE)~ ~Spell(Myself,CLERIC_HEALING_CIRCLE)~
  END
 BUT_ONLY_IF_IT_CHANGES
END
